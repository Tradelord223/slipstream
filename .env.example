# Where people will open Slipstream. Used for OAuth redirects and invite links.
SLIPSTREAM_PUBLIC_URL=https://mail.example.com
# Encrypts stored mail credentials. Generate with: openssl rand -base64 32  (keep it safe; don't change it)
SLIPSTREAM_SECRET=

# Optional: let anyone with the URL create an account (default: invite-only after the first owner)
# SLIPSTREAM_OPEN_SIGNUP=1

# Gmail via Google's API (see docs/connect-accounts.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook / Microsoft 365 via Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Optional: one Anthropic key for the whole server (people can also add their own in Settings → AI)
# ANTHROPIC_API_KEY=

# Optional: continuous backups (S3, R2, Tigris, B2, MinIO)
# LITESTREAM_REPLICA_URL=s3://my-bucket/slipstream
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
